{
  "name": "mantine-next-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "collect:config": "tsx collector/config-cli.ts",
    "collect": "tsx collector/cli.ts",
    "test:collection:postgres": "tsx --test --test-concurrency=1 collector/postgres.integration.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run oxlint && npm run stylelint",
    "oxlint": "oxlint -c oxlint.config.mjs .",
    "stylelint": "stylelint '**/*.css' --cache",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "format:test": "oxfmt -c oxfmt.config.mjs --check \"**/*.{ts,tsx,css}\"",
    "format:write": "oxfmt -c oxfmt.config.mjs --write \"**/*.{ts,tsx,css}\"",
    "knip": "knip",
    "test": "npx next typegen && npm run format:test && npm run lint && npm run typecheck && npm run knip && npm run jest && npm run test:documents",
    "test:documents": "tsx --test tests/markdown.integration.ts tests/pdf.integration.ts tests/import.integration.ts tests/resume-markdown.integration.ts",
    "test:db": "node scripts/test-database.mjs",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@mantine/core": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@next/bundle-analyzer": "^16.0.0",
    "@next/env": "16.4.6",
    "@react-pdf/renderer": "^4.9.1",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.3.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "unpdf": "^2.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/addon-themes": "^10.0.0",
    "@storybook/nextjs": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "knip": "^6.47.0",
    "oxc-config-mantine": "^1.0.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.70.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "^10.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "yarn@4.18.1"
}
