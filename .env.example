# Local development only. These credentials match compose.yaml.
DATABASE_URL=postgresql://kyu:kyu@localhost:5432/kyu
POSTGRES_PORT=5432

# Optional, server/CLI only. Never use NEXT_PUBLIC_ for provider credentials.
# Missing keys skip Hirebase explicitly; board collection does not need a key.
HIREBASE_API_KEY=

# Optional AI connections are entered in /settings/ai and encrypted in PostgreSQL.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep private and back up; changing/losing it makes saved connections unreadable.
KYU_AI_ENCRYPTION_KEY=
